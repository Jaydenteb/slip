# Copy to .env and fill in. Never commit .env.

# Local Postgres (docker compose up -d)
DATABASE_URL=postgresql://slip:slip@localhost:5433/slip

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# From the webhook you register on the same sandbox app
PAYPAL_WEBHOOK_ID=

# Anthropic (set a spending limit on this key)
ANTHROPIC_API_KEY=

# Sandbox accounts (developer.paypal.com → Testing Tools → Sandbox Accounts).
# The school invoices from the business one; the demo family (Nguyen) is billed to the personal one.
SANDBOX_SCHOOL_EMAIL=
SANDBOX_PARENT_EMAIL=
