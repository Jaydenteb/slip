{
  "name": "slip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "spike": "tsx --env-file=.env scripts/spike.ts",
    "try-parse": "tsx --env-file=.env scripts/try-parse.ts",
    "e2e:office": "tsx --env-file=.env scripts/e2e-office.ts",
    "sync": "tsx --env-file=.env scripts/sync.ts",
    "try-chat": "tsx --env-file=.env scripts/try-chat.ts",
    "approve": "tsx --env-file=.env scripts/approve.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"tests/db/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "6.19",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
